{
	"name": "neuroglancer-plugin",
	"pluginName": "Neuroglancer",
	"icon": "./icon.svg",
	"index": "./index.html",
	"dockerCompose": "./compose.yml",
	"private": true,
	"version": "1.1.0",
	"packageManager": "npm@11.19.0",
	"engines": {
		"node": ">=24",
		"npm": "11.19.0"
	},
	"type": "module",
	"main": "dist/main.js",
	"files": [
		"dist"
	],
	"scripts": {
		"dev-frontend": "vite",
		"dev-backend": "node backend-dev.cjs",
		"dev": "concurrently \"npm run dev-frontend\" \"npm run dev-backend\"",
		"build": "tsc -b && vite build",
		"build:release": "npm run build && node scripts/write-release-manifest.mjs",
		"validate:release": "node scripts/validate-release-manifest.mjs",
		"validate:archive": "node scripts/validate-release-archive.mjs",
		"test": "npm run typecheck:test && node --test tests/directoryRequests.test.ts",
		"typecheck:test": "tsc --noEmit -p tsconfig.test.json",
		"smoke:dev": "node scripts/smoke-vite-server.mjs",
		"lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
		"preview": "vite preview"
	},
	"dependencies": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"@types/react": "^18.3.3",
		"@types/react-dom": "^18.3.0",
		"@typescript-eslint/eslint-plugin": "^7.15.0",
		"@typescript-eslint/parser": "^7.15.0",
		"@vitejs/plugin-react": "^4.7.0",
		"concurrently": "^8.2.2",
		"docker-compose": "^0.24.8",
		"eslint": "^8.57.0",
		"eslint-plugin-react-hooks": "^4.6.2",
		"eslint-plugin-react-refresh": "^0.4.7",
		"typescript": "^5.2.2",
		"vite": "^6.4.3",
		"vite-plugin-static-copy": "^2.3.2"
	},
	"allowScripts": {
		"esbuild": true
	}
}
